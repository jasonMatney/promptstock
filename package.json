{
  "name": "skills-jam-world",
  "version": "4.0.0",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "check:engine": "node scripts/check-engine.mjs",
    "test": "npm run check:engine && npm run build && node --test tests/*.test.cjs",
    "review:repair": "esbuild tests/fixtures/repair-preview.mjs --bundle --format=esm --target=es2022 --outfile=tests/fixtures/repair-preview.js",
    "review:mixer": "esbuild tests/fixtures/mixer-preview.mjs --bundle --format=esm --target=es2022 --outfile=tests/fixtures/mixer-preview.js",
    "review:records": "esbuild tests/fixtures/records-preview.mjs --bundle --format=esm --target=es2022 --outfile=tests/fixtures/records-preview.js",
    "smoke": "node scripts/smoke-game-debug.mjs",
    "smoke:browser": "node scripts/smoke-browser.mjs",
    "test:visual": "node scripts/compare-visual.mjs",
    "smoke:visual": "node scripts/compare-visual.mjs",
    "optimize:rasters": "node scripts/optimize-rasters.mjs",
    "export:kits": "node scripts/export-kits.mjs",
    "measure:kits": "node scripts/measure-kits.mjs",
    "check:glb-budgets": "node scripts/check-glb-budgets.mjs",
    "compress:glbs": "node scripts/compress-glbs.mjs",
    "render:turnaround": "node scripts/render-turnaround.mjs",
    "pipeline:check": "node scripts/pipeline-check.mjs",
    "pipeline:kits": "npm run export:kits && npm run compress:glbs && npm run measure:kits -- --write-md && npm run check:glb-budgets && npm run build && npm test",
    "author:kits": "node scripts/author-kits.mjs",
    "capture:art": "node scripts/capture-art-review.mjs"
  },
  "dependencies": {
    "esbuild": "0.28.2",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "jpeg-js": "^0.4.4",
    "meshoptimizer": "^0.25.0",
    "pixelmatch": "^7.2.0",
    "playwright": "1.55.1",
    "pngjs": "^7.0.0",
    "sharp": "^0.35.4"
  }
}
